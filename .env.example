# Required — ESI ToS asks for a contactable identifier in User-Agent.
# Email strongly preferred; app URL or Discord handle also accepted.
EVE_ESI_MCP_CONTACT=you@example.com

# Optional — where the ESI HTTP cache and (if SSO used) refresh tokens are stored.
# Defaults follow XDG spec: ~/.cache/eve-esi-mcp and ~/.local/share/eve-esi-mcp
# EVE_ESI_MCP_CACHE_DIR=
# EVE_ESI_MCP_DATA_DIR=

# Optional — SSO / character tools. Register app at developers.eveonline.com,
# enable PKCE, set callback http://localhost:8765/callback.
# EVE_SSO_CLIENT_ID=
# EVE_SSO_CALLBACK_PORT=8765
# EVE_SSO_SCOPES=esi-wallet.read_character_wallet.v1 esi-assets.read_assets.v1 esi-markets.read_character_orders.v1 esi-skills.read_skills.v1 esi-industry.read_character_jobs.v1
